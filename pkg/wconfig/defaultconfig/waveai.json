{
    "waveai@quick": {
        "display:name": "Quick",
        "display:order": -3,
        "display:icon": "bolt",
        "display:description": "Fastest responses (gpt-5-mini)",
        "ai:provider": "wave",
        "ai:apitype": "openai-responses",
        "ai:model": "gpt-5-mini",
        "ai:thinkinglevel": "low",
        "ai:verbosity": "low",
        "ai:capabilities": ["tools", "images", "pdfs"],
        "ai:switchcompat": ["wavecloud"]
    },
    "waveai@balanced": {
        "display:name": "Balanced",
        "display:order": -2,
        "display:icon": "sparkles",
        "display:description": "Good mix of speed and accuracy\n(gpt-5.1 with minimal thinking)",
        "ai:provider": "wave",
        "ai:apitype": "openai-responses",
        "ai:model": "gpt-5.1",
        "ai:thinkinglevel": "low",
        "ai:verbosity": "low",
        "ai:capabilities": ["tools", "images", "pdfs"],
        "waveai:premium": true,
        "ai:switchcompat": ["wavecloud"]
    },
    "waveai@deep": {
        "display:name": "Deep",
        "display:order": -1,
        "display:icon": "lightbulb",
        "display:description": "Slower but most capable\n(gpt-5.1 with full reasoning)",
        "ai:provider": "wave",
        "ai:apitype": "openai-responses",
        "ai:model": "gpt-5.1",
        "ai:thinkinglevel": "medium",
        "ai:verbosity": "low",
        "ai:capabilities": ["tools", "images", "pdfs"],
        "waveai:premium": true,
        "ai:switchcompat": ["wavecloud"]
    },
    "waveai@ollama": {
        "display:name": "Ollama (Local)",
        "display:order": 10,
        "display:icon": "server",
        "display:description": "Run AI models locally via Ollama\n(no API key needed)",
        "ai:provider": "ollama",
        "ai:apitype": "openai-chat",
        "ai:model": "llama3.2",
        "ai:endpoint": "http://localhost:11434/v1/chat/completions",
        "ai:capabilities": ["tools", "images"]
    },
    "waveai@opencode": {
        "display:name": "OpenCode Zen",
        "display:order": 11,
        "display:icon": "zap",
        "display:description": "Coding-optimized gateway via OpenCode Zen\n(get API key at opencode.ai/auth)",
        "ai:provider": "opencode",
        "ai:apitype": "openai-chat",
        "ai:model": "opencode/gpt-5.4",
        "ai:endpoint": "https://opencode.ai/zen/v1/chat/completions",
        "ai:capabilities": ["tools", "images", "pdfs"]
    },
    "waveai@kronos": {
        "display:name": "Kronos Local",
        "display:order": 12,
        "display:icon": "server",
        "display:description": "KronosCode AI engine with full agent capabilities",
        "ai:provider": "kronos",
        "ai:apitype": "kronos-session",
        "ai:model": "build",
        "ai:endpoint": "http://127.0.0.1:3001",
        "ai:kronostoolrouting": "wave-only",
        "ai:capabilities": ["tools"]
    },
    "waveai@kronos-computer-use": {
        "display:name": "Kronos Computer Use",
        "display:order": 13,
        "display:icon": "monitor-cog",
        "display:description": "KronosCode computer-use agent with Bytebot MCP desktop control",
        "ai:provider": "kronos",
        "ai:apitype": "kronos-session",
        "ai:model": "computer-use",
        "ai:endpoint": "http://127.0.0.1:3001",
        "ai:kronostoolrouting": "wave-only",
        "ai:capabilities": ["tools"]
    }
}
