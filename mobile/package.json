{
    "name": "@kronterm/iphone",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:host": "node --test host/*.test.mjs",
        "test:watch": "vitest",
        "ios:add": "cap add ios",
        "ios:sync": "npm run build && cap sync ios",
        "ios:open": "cap open ios",
        "host": "node host/kronlink-host.mjs"
    },
    "dependencies": {
        "@aparajita/capacitor-secure-storage": "^8.0.0",
        "@capacitor/app": "^8.1.1",
        "@capacitor/core": "^8.0.0",
        "@capacitor/haptics": "^8.0.0",
        "@capacitor/keyboard": "^8.0.0",
        "@capacitor/status-bar": "^8.0.0",
        "@fontsource-variable/manrope": "^5.2.8",
        "@fontsource-variable/newsreader": "^5.2.8",
        "@fontsource/ibm-plex-mono": "^5.2.6",
        "@kronterm/local-shell": "file:plugins/local-shell",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.0.0",
        "@capacitor/ios": "^8.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-react": "^5.0.0",
        "jsdom": "^27.0.0",
        "typescript": "^5.9.0",
        "vite": "^7.0.0",
        "vitest": "^4.0.0"
    }
}
