{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wavetermdev/waveterm/pkg/wconfig/settings-type",
  "$ref": "#/$defs/SettingsType",
  "$defs": {
    "ACPAgentDefinition": {
      "properties": {
        "name": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "temperature": {
          "type": "number"
        },
        "topp": {
          "type": "number"
        },
        "systemprompt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ACPAgentProfile": {
      "properties": {
        "model": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "executable": {
          "type": "string"
